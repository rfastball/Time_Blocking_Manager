      "css": ".ds-secondary{font-family:\"Segoe UI\",\"Malgun Gothic\",sans-serif;font-size:14px;color:var(--text,#1b1e23);cursor:pointer;background:var(--surface,#fff);border:1px solid var(--border,#d9dce1);border-radius:6px;padding:8px 12px;min-height:34px;}.ds-secondary:hover{background:var(--control-hover,#f0f3fa);}.ds-secondary:focus-visible{outline:2px solid var(--focus,#2b55d6);outline-offset:3px;}.ds-secondary:disabled{opacity:.55;cursor:default;}@media(prefers-reduced-motion:no-preference){.ds-secondary{transition:background-color 100ms ease-out,border-color 100ms ease-out;}}"
    },
    {

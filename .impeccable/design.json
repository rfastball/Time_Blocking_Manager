      "kind": "input",
      "refersTo": "capture-input",
      "description": "620×148 native 창의 단일 입력과 Enter/Esc 안내.",
      "html": "<div class=\"ds-capture\"><form class=\"ds-capture-form\"><input aria-label=\"빠른 캡처\" placeholder=\"할 일을 입력하세요\"><button type=\"button\" aria-label=\"저장\">↵</button></form><div class=\"ds-meta\"><span>보관함 3</span><span><kbd>Enter</kbd> 추가 <kbd>Esc</kbd> 닫기</span></div></div>",
      "css": ".ds-capture{font-family:\"Segoe UI\",\"Malgun Gothic\",sans-serif;font-size:14px;color:var(--text,#1b1e23);background:var(--surface,#fff);padding:20px 24px;}.ds-capture-form{display:flex;gap:12px;align-items:center;}.ds-capture input{font-family:\"Segoe UI\",\"Malgun Gothic\",sans-serif;font-size:14px;color:var(--text,#1b1e23);width:100%;min-width:0;height:54px;font-size:24px;border:0;background:transparent;padding:8px 0;outline:none;caret-color:var(--blue,#2b55d6);}.ds-capture input::placeholder{color:var(--muted,#5b6270);}.ds-capture button{font-family:\"Segoe UI\",\"Malgun Gothic\",sans-serif;font-size:14px;color:var(--text,#1b1e23);cursor:pointer;background:var(--surface,#fff);border:1px solid var(--border,#d9dce1);border-radius:6px;padding:8px 12px;min-height:34px;border:0;background:transparent;color:var(--blue,#2b55d6);font-size:24px;}.ds-capture button:hover{background:transparent;}.ds-capture button:focus-visible{outline:2px solid var(--focus,#2b55d6);outline-offset:3px;}.ds-meta{display:flex;justify-content:space-between;color:var(--muted,#5b6270);font-size:11px;margin-top:10px;}.ds-meta kbd{font:inherit;padding:2px 4px;border:1px solid var(--border,#d9dce1);border-radius:6px;margin-left:8px;}"

      "html": "<button class=\"ds-primary\">저장</button>",
      "css": ".ds-primary{font-family:\"Segoe UI\",\"Malgun Gothic\",sans-serif;font-size:14px;color:var(--text,#1b1e23);cursor:pointer;background:var(--surface,#fff);border:1px solid var(--border,#d9dce1);border-radius:6px;padding:8px 12px;min-height:34px;background:var(--blue,#2b55d6);border-color:var(--blue,#2b55d6);color:var(--surface,#fff);}.ds-primary:hover{background:var(--blue-hover,#2145b7);}.ds-primary:focus-visible{outline:2px solid var(--focus,#2b55d6);outline-offset:3px;}.ds-primary:disabled{opacity:.55;cursor:default;}@media(prefers-reduced-motion:no-preference){.ds-primary{transition:background-color 100ms ease-out,border-color 100ms ease-out;}}"
    },
